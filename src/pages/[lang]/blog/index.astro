const POSTS_PER_PAGE = 9;
---

<Layout
  lang={lang}
  t={t}
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonicalPath="/blog"
>
  <section class="w-full pt-(--header-height) flex justify-center items-center">
    <div
      class="pt-16 md:pt-20 pb-10 flex flex-col justify-center items-center gap-6 text-paragraph"
    >
      <p class="paragraph fade-up-a">{t.blog.tag}</p>
      <AnimatedTitle text={t.blog.title} tag="h1" class="title-2 text-center" />
    </div>
  </section>

  {
    POSTS.length > 0 ? (
      <BlogSection
        items={POSTS}
        category={CATEGORIES}
        lang={lang}
        perPage={POSTS_PER_PAGE}
        client:load
      />
    ) : (
      <p class="paragraph text-paragraph text-center pb-16">
        {lang === "es"
          ? "Pronto publicaremos nuevos artículos."
          : "New articles coming soon."}
      </p>
    )
  }

  <Reviews items={t.main.reviews} client:load />
</Layout>