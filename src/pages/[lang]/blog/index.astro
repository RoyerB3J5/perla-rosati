---
// Página SSR (sin getStaticPaths, sin build-time): las queries a GoHighLevel
// corren EN CADA VISITA dentro de la función serverless, igual que BLOG-REFERENCE.
// La paginación es interna (client-side, sin `?page=` en la URL).
export const prerender = false;

import AnimatedTitle from "../../../components/AnimatedTitle.astro";
import en from "../../../i18n/en";
import es from "../../../i18n/es";
import Layout from "../../../layouts/Layout.astro";
import BlogSection from "../../../sections/BlogSection";
import Reviews from "../../../sections/Main/Reviews";
// Queries en vivo (sin usar por ahora):
import { getPostsPage, getCategories } from "../../../lib/ghl/blog-services";
import type { BlogCardDTO } from "../../../lib/ghl/types";
import type { Language } from "../../../types/language.type";

const lang = Astro.params.lang as Language;
const translations = { es, en };
const t = translations[lang] ?? en;
const seo = t.seo.blog;

// --- Contenido estático (en uso) ---
const CATEGORIES = [
  { id: "1", title: "TODO" },
  { id: "2", title: "MAQUILLAJE" },
  { id: "3", title: "CABELLO" },
  { id: "4", title: "PELUQUERÍA" },
  { id: "5", title: "FACIALES" },
  { id: "6", title: "CEJAS Y PESTAÑAS" },
  { id: "7", title: "LASER" },
];
const POSTS = [
  {
    image: "/images/blog/1.webp",
    date: "AUGUST 18, 2026",
    id: `1`,
    title: "Maquillaje natural: donde menos es más",
    description:
      "Un maquillaje natural puede transformar tu apariencia sin ocultar quién eres. Conoce las claves para conseguir una piel luminosa, fresca y elegante.",
    idCategory: "6",
  },
  {
    image: "/images/blog/2.webp",
    date: "AUGUST 19, 2026",
    id: `1`,
    title: "5 consejos para un maquillaje duradero",
    description:
      "Preparar correctamente la piel y elegir los productos adecuados puede ser la diferencia. Descubre nuestros consejos para tener tu maquillaje impecable durante horas.",
    idCategory: "3",
  },
  {
    image: "/images/blog/3.webp",
    date: "AUGUST 20, 2026",
    id: `1`,
    title: "Encuentra el mejor look que habla de ti",
    description:
      "Tu maquillaje también comunica tu personalidad. Explora cómo elegir un look que resalte tus facciones, refleje tu estilo y te haga sentir auténtica.",
    idCategory: "2",
  },
  {
    image: "/images/blog/1.webp",
    date: "AUGUST 18, 2026",
    id: `1`,
    title: "Maquillaje natural: donde menos es más",
    description:
      "Un maquillaje natural puede transformar tu apariencia sin ocultar quién eres. Conoce las claves para conseguir una piel luminosa, fresca y elegante.",
    idCategory: "6",
  },
  {
    image: "/images/blog/2.webp",
    date: "AUGUST 19, 2026",
    id: `1`,
    title: "5 consejos para un maquillaje duradero",
    description:
      "Preparar correctamente la piel y elegir los productos adecuados puede ser la diferencia. Descubre nuestros consejos para tener tu maquillaje impecable durante horas.",
    idCategory: "3",
  },
  {
    image: "/images/blog/3.webp",
    date: "AUGUST 20, 2026",
    id: `1`,
    title: "Encuentra el mejor look que habla de ti",
    description:
      "Tu maquillaje también comunica tu personalidad. Explora cómo elegir un look que resalte tus facciones, refleje tu estilo y te haga sentir auténtica.",
    idCategory: "2",
  },
];

// --- Queries en vivo (sin usar por ahora) ---
/*
// Queries en vivo: traemos TODOS los posts (recorriendo las páginas de GHL)
// para poder paginar internamente en el navegador sin cambiar la URL.
const POSTS_PER_PAGE = 9;
let POSTS: BlogCardDTO[] = [];
let CATEGORIES: { id: string; title: string }[] = [];

try {
  const [firstPage, categories] = await Promise.all([
    getPostsPage(1),
    getCategories(),
  ]);
  POSTS = [...firstPage.items];
  for (let p = 2; p <= firstPage.totalPages; p++) {
    const res = await getPostsPage(p);
    POSTS.push(...res.items);
  }
  CATEGORIES = categories.map((c) => ({ id: c.id, title: c.label.toUpperCase() }));
} catch (err) {
  console.error("[blog] GHL fetch failed, rendering empty list:", err);
  POSTS = [];
  CATEGORIES = [];
}
*/

const POSTS_PER_PAGE = 9;

// --- Queries en vivo: contenido dinámico de GHL ---
// Variables con prefijo `live` para no chocar con POSTS / CATEGORIES estáticos.
let liveAllPosts: BlogCardDTO[] = [];
let liveCategoriesRaw: { id: string; label: string }[] | null = null;
let liveError = null;
try {
  const [firstPage, categoriesResult] = await Promise.all([
    getPostsPage(1),
    getCategories(),
  ]);
  liveAllPosts = [...firstPage.items];
  for (let p = 2; p <= firstPage.totalPages; p++) {
    const res = await getPostsPage(p);
    liveAllPosts.push(...res.items);
  }
  liveCategoriesRaw = categoriesResult;
} catch (err) {
  console.error("[blog] GHL fetch failed:", err);
  liveError = err instanceof Error ? err.message : String(err);
}

// --- Títulos multilingües SOLO para el resultado live ---
// El filtro de BlogSection compara por `id` (item.idCategory === activeCategory),
// así que el `title` es solo display y se puede traducir sin romper el filtro.
// El `id` siempre se conserva tal cual lo devuelve la query.
// Se busca primero por ID de GHL, luego por label normalizado, con fallback al label.
const LIVE_CATEGORY_TITLES_BY_ID: Record<string, { es: string; en: string }> = {
  all: { es: "TODO", en: "ALL" },
  "6ab425ed67a82011c2a6c20c": { es: "BELLEZA ", en: "BEAUTY" },
  // Ej: "68f123abc...": { es: "MAQUILLAJE", en: "MAKEUP" },
};
const LIVE_CATEGORY_TITLES_BY_LABEL: Record<
  string,
  { es: string; en: string }
> = {
  all: { es: "TODO", en: "ALL" },
  makeup: { es: "MAQUILLAJE", en: "MAKEUP" },
  hair: { es: "CABELLO", en: "HAIR" },
  hairstyling: { es: "PELUQUERÍA", en: "HAIRSTYLING" },
  facials: { es: "FACIALES", en: "FACIALS" },
  "eyebrows-lashes": { es: "CEJAS Y PESTAÑAS", en: "BROWS & LASHES" },
  "brows-lashes": { es: "CEJAS Y PESTAÑAS", en: "BROWS & LASHES" },
  laser: { es: "LÁSER", en: "LASER" },
};

const liveDisplayCategories = ((liveCategoriesRaw as any[]) ?? []).map((c) => ({
  // ID intacto de la query — es lo que usa el filtro, no se traduce.
  id: c.id,
  title: (
    LIVE_CATEGORY_TITLES_BY_ID[c.id]?.[lang] ??
    LIVE_CATEGORY_TITLES_BY_LABEL[c.label?.toLowerCase()]?.[lang] ??
    c.label
  ).toUpperCase(),
}));

// Si hay resultado live se usa ese (con IDs de GHL + títulos traducidos);
// si no, se sigue usando la constante estática CATEGORIES sin cambios.
const displayCategories =
  liveDisplayCategories.length > 0 ? liveDisplayCategories : CATEGORIES;

// Contenido dinámico: respuesta live de GHL; fallback al contenido estático
// (POSTS) si la query falla o viene vacía. No se borra el contenido estático.
const displayPosts = liveAllPosts.length > 0 ? liveAllPosts : POSTS;
if (liveError) {
  console.error(
    "[blog] usando contenido estático por fallo de GHL:",
    liveError,
  );
}
---

<Layout
  lang={lang}
  t={t}
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonicalPath="/blog"
>
  <section class="w-full pt-(--header-height) flex justify-center items-center">
    <div
      class="pt-16 md:pt-20 pb-10 flex flex-col justify-center items-center gap-6 text-paragraph"
    >
      <p class="paragraph fade-up-a">{t.blog.tag}</p>
      <AnimatedTitle text={t.blog.title} tag="h1" class="title-2 text-center" />
    </div>
  </section>

  {
    displayPosts.length > 0 ? (
      <BlogSection
        items={displayPosts}
        category={displayCategories}
        lang={lang}
        perPage={POSTS_PER_PAGE}
        client:load
      />
    ) : (
      <p class="paragraph text-paragraph text-center pb-16">
        {lang === "es"
          ? "Pronto publicaremos nuevos artículos."
          : "New articles coming soon."}
      </p>
    )
  }

  <Reviews items={t.main.reviews} client:load />
</Layout>
