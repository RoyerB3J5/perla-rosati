---
import AnimatedTitle from "../../../components/AnimatedTitle.astro";
import en from "../../../i18n/en";
import es from "../../../i18n/es";
import Layout from "../../../layouts/Layout.astro";
import Questions from "../../../sections/Main/Questions.astro";
import Reviews from "../../../sections/Main/Reviews";
import Services from "../../../sections/Services.astro";
import type { Language } from "../../../types/language.type";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

export const defaultRedirect = "/en";

const lang = Astro.params.lang as Language;
const translations = { es, en };
const t = translations[lang];
const seo = t.seo.services;

---

<Layout
  lang={lang}
  t={t}
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonicalPath="/services"
>
  <section
    class="container-full pt-(--header-height) pb-8 md:pb-10 flex justify-center"
  >
    <AnimatedTitle
      text={t.services.title}
      tag="h1"
      class="title-2 text-paragraph pt-16 md:pt-20"
    />
  </section>
  <Services categorie={t.services.categories} items={t.services.servicesItems} />
  <Reviews items={t.main.reviews} client:load />
  <Questions content={t.services.questions} lang={lang} />
</Layout>
