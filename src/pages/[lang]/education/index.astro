---
import AnimatedTitle from "../../../components/AnimatedTitle.astro";
import en from "../../../i18n/en";
import es from "../../../i18n/es";
import Layout from "../../../layouts/Layout.astro";
import GridEducation from "../../../sections/GridEducation.astro";
import Questions from "../../../sections/Main/Questions.astro";
import Reviews from "../../../sections/Main/Reviews";
import type { Language } from "../../../types/language.type";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

export const defaultRedirect = "/en";

const lang = Astro.params.lang as Language;
const translations = { es, en };
const t = translations[lang];
const seo = t.seo.education;
---

<Layout
  lang={lang}
  t={t}
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonicalPath="/education"
>
  <section class="container-full pt-16 md:pt-(--header-height) pb-14 flex justify-center">
    <AnimatedTitle text={t.education.title} tag="h1" class="title-2 text-paragraph pt-16 md:pt-20 text-center" />
  </section>
  <GridEducation content={t.education.items} />
  <Reviews items={t.main.reviews} client:load />
  <Questions content={t.education.questions} lang={lang} />
</Layout>
