---
import AnimatedTitle from "../../components/AnimatedTitle.astro";
type Translations = typeof import("../../i18n/en").default;
type FormContent = Translations["contact"]["form"];
interface Props {
  content: FormContent;
}
const { content } = Astro.props as Props;
---

<section
  class="container-full flex flex-col md:flex-row justify-center items-center py-16 md:py-20 gap-8 md:gap-6"
>
  <div
    class="w-full md:w-1/2 flex flex-col justify-start items-start gap-2.5 text-paragraph"
  >
    <div class="flex flex-col justify-center items-start gap-6 md:gap-4">
      <p class="paragraph-medium uppercase fade-up-a">{content.tag}</p>
      <AnimatedTitle text={content.title} tag="h2" class="title-3" />
      <p class="paragraph fade-up-a" style="animation-delay:0.5s">{content.description}</p>
    </div>
  </div>
  <div
    class="w-full md:w-1/2 h-auto relative overflow-hidden reveal-rtl"
    style="aspect-ratio: 628/644"
  >
    <img
      src="/images/form-contact.webp"
      alt="Form"
      width="1000"
      height="667"
      decoding="async"
      loading="lazy"
      class="h-full w-full object-cover object-[30%_50%]"
    />
  </div>
</section>
