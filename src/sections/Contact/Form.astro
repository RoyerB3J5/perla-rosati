---
type Translations = typeof import("../../i18n/en").default;
type FormContent = Translations["contact"]["form"];
interface Props {
  content: FormContent;
}
const { content } = Astro.props as Props;
---

<section class="container-full flex justify-center items-center py-20 gap-6">
  <div
    class="w-1/2 flex flex-col justify-start items-start gap-1-0 text-paragraph"
  >
    <div class="flex flex-col justify-center items-start gap-4">
      <p class="paragraph-medium uppercase">{content.tag}</p>
      <h2 class="title-3">{content.title}</h2>
      <p class="paragraph">{content.description}</p>
    </div>
  </div>
  <div
    class="w-1/2 h-auto relative overflow-hidden"
    style="aspect-ratio: 628/644"
  >
    <img
      src="/images/form-contact.webp"
      alt="Form"
      width="1000"
      height="667"
      decoding="async"
      loading="lazy"
      class="h-full w-full object-cover object-[30%_50%]"
    />
  </div>
</section>
