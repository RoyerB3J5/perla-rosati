---
import AnimatedTitle from "../../components/AnimatedTitle.astro";
import Button from "../../components/Button.astro";
import { Plus, Minus } from "@lucide/astro";
type Translations = typeof import("../../i18n/en").default;
type ContactContent = Translations["contact"]["hero"];
interface Props {
  content: ContactContent;
}
const { content } = Astro.props as Props;
---

<section
  class="w-full flex justify-center items-center pt-(--header-height) relative"
>
  <div
    class="container-full flex flex-col md:flex-row justify-center items-center gap-8 md:gap-6 py-16 md:py-20"
  >
    <img
      src="/images/map.webp"
      alt="Map"
      width="1024"
      height="1024"
      class="w-full md:w-1/2 h-auto order-2 md:order-1 reveal-ltr"
      decoding="async"
      loading="eager"
    />
    <div
      class="flex flex-col justify-center items-start gap-6 md:gap-5.5 p-0 md:p-8 order-1 md:order-2"
    >
      <div
        class="w-full flex flex-col justify-start items-start gap-6 text-paragraph"
      >
        <p class="uppercase paragraph-medium fade-up-a">{content.tag}</p>
        <AnimatedTitle
          text={content.title}
          tag="h1"
          class="title-2 md:title-3"
        />
      </div>
      <div
        class="w-full h-[1.5px] bg-paragraph fade-up-a"
        style="animation-delay:0.5s"
      >
      </div>
      <p class="paragraph fade-up-a" style="animation-delay:0.5s">
        {content.description}
      </p>
      <ul
        class="flex flex-col justify-start items-start gap-1 text-paragraph fade-up-a"
        style="animation-delay:0.5s"
      >
        {
          content.items.map((item) => (
            <li class="paragraph list-disc list-outside ml-4 ">
              <span class="font-medium">{item.label}</span>
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-all hover:[text-shadow:0_0_1px_currentColor] duration-300 ease-in-out"
              >
                {item.value}
              </a>
            </li>
          ))
        }
      </ul>
      <Button
        text={content.button.label}
        href="https://wa.me/17867813547"
        extraBtnClass="fade-up-slow [--delay:0.5s]"
      />
    </div>
  </div>
</section>
