---
import Button from "../components/Button.astro";

interface Props {
  content: {
    image: string;
    title: string;
    description: string;
    lists: string[];
    duration: string;
    href: string;
  }[];
}
const { content } = Astro.props as Props;
---

<section
  class="container-full flex flex-col justify-center items-center gap-12"
>
  {
    content.map((item, index) => {
      const isEven = index % 2 === 0;
      return (
        <div class="flex flex-col md:flex-row justify-center items-stretch gap-8 md:gap-4 lg:gap-10 ">
          <div
            class={`flex-1 flex flex-col justify-between items-start md:py-6 lg:px-4 xl:px-8 gap-7 md:gap-8 xl:gap-0 ${isEven ? "order-2 md:order-1" : "order-2"}`}
          >
            <div class="flex flex-col justify-start items-start gap-8 md:gap-6 xl:gap-7 text-paragraph w-full">
              <div class="w-full h-[1.5px] bg-paragraph" />
              <p class="paragraph">0{index + 1}/</p>
              <h2 class="title-4 uppercase">{item.title}</h2>
              <p class="paragraph">{item.description}</p>
              <div class="flex flex-col justify-start items-start gap-6 md:gap-5 text-paragraph py-6 border-y-[1.5px] border-[#BAB6B2] w-full">
                <p class="paragraph uppercase">5 puntos importantes:</p>
                <ul class="flex flex-col justify-start items-start gap-0.5 text-paragraph list-disc list-outside ml-4">
                  {item.lists.map((listItem) => (
                    <li class="paragraph">{listItem}</li>
                  ))}
                </ul>
              </div>
            </div>
            <p class="paragraph">{item.duration}</p>
            <Button text="INSCRIBIRME" href={item.href} />
          </div>
          <div
            class={`w-full md:w-[50%] h-auto relative overflow-hidden ${isEven ? "order-1 md:order-2" : "order-1"}`}
            style="aspect-ratio: 1/1"
          >
            <img
              src={item.image}
              alt={item.title}
              width="1024"
              height="1024"
              decoding="async"
              loading="lazy"
              class="w-full h-full absolute inset-0 object-cover object-center"
            />
          </div>
        </div>
      );
    })
  }
</section>
