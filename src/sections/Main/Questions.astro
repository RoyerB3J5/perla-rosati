---
import Button from "../../components/Button.astro";
import { Plus, Minus } from "@lucide/astro";
type Translations = typeof import("../../i18n/en").default;
type QuestionsContent = Translations["main"]["questions"];
interface Props {
  content: QuestionsContent;
  lang: "es" | "en";
}
const { content, lang } = Astro.props as Props;
---

<style>
  .answer-content {
    overflow: hidden;
    transition: all 300ms ease-out;
  }
  .answer-content.is-open {
    max-height: 500px;
    opacity: 1;
  }
  .answer-content:not(.is-open) {
    max-height: 0;
    opacity: 0;
    margin-top: 0;
  }
  .toggle-btn {
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    align-items: center;
    justify-content: center;
  }
  .toggle-btn .icon-minus {
    display: none;
  }
  .toggle-btn.is-open .icon-plus {
    display: none;
  }
  .toggle-btn.is-open .icon-minus {
    display: block;
  }
  .toggle-btn:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 4px;
  }
</style>

<section
  class="container-full flex flex-col md:flex-row justify-center md:justify-between items-center md:items-start py-16 md:py-30 gap-12 md:gap-8 xl:gap-0"
>
  <div
    class="flex flex-col justify-center items-start gap-8 text-paragraph max-w-none md:max-w-[289px]"
  >
    <h2 class="title-2">{content.title}</h2>
    <p class="paragraph">{content.description}</p>
  </div>
  <div
    class="flex flex-col justify-center items-center gap-6 md:gap-8 max-w-[809px] w-full"
  >
    {
      content.items.map((item, index) => (
        <>
          <div
            class="w-full flex justify-between items-start border-b-[1.5px] last:border-transparent border-paragraph "
            data-question
          >
            <div class="w-full flex flex-col md:flex-row  justify-start items-start gap-6 md:gap-8">
              <p class="paragraph-medium">0{index + 1}/</p>
              <div class="flex w-full justify-between items-start">
                <div class="flex flex-col justify-center items-start gap-6 md:gap-8 max-w-[607px]">
                  <h3 class="paragraph-medium uppercase">{item.title}</h3>
                  <div class="answer-content" data-answer>
                    <p class="paragraph pb-6 md:pb-8" set:html={item.answer} />
                  </div>
                </div>
                <button
                  class="toggle-btn flex md:hidden"
                  aria-expanded={index === 0}
                  aria-controls={`answer-${index}`}
                  data-index={index}
                >
                  <Plus class="icon-plus w-6 h-6 text-paragraph" />
                  <Minus class="icon-minus w-6 h-6 text-paragraph" />
                </button>
              </div>
            </div>
            <button
              class="toggle-btn hidden md:flex"
              aria-expanded={index === 0}
              aria-controls={`answer-${index}`}
              data-index={index}
            >
              <Plus class="icon-plus w-6 h-6 text-paragraph" />
              <Minus class="icon-minus w-6 h-6 text-paragraph" />
            </button>
          </div>
        </>
      ))
    }
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const questions = document.querySelectorAll("[data-question]");

    questions.forEach((question, index) => {
      const btns = question.querySelectorAll(".toggle-btn");
      const answer = question.querySelector("[data-answer]");
      let isOpen = index === 0;

      const setOpen = (open) => {
        answer.classList.toggle("is-open", open);
        btns.forEach((b) => {
          b.classList.toggle("is-open", open);
          b.setAttribute("aria-expanded", String(open));
        });
        isOpen = open;
      };

      if (index === 0) {
        setOpen(true);
      }

      btns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const currentlyOpen = answer.classList.contains("is-open");
          if (currentlyOpen) {
            // Close this one
            setOpen(false);
          } else {
            // Close all others
            questions.forEach((q, i) => {
              if (i !== index) {
                const otherBtns = q.querySelectorAll(".toggle-btn");
                const otherAnswer = q.querySelector("[data-answer]");
                otherAnswer.classList.remove("is-open");
                otherBtns.forEach((b) => {
                  b.classList.remove("is-open");
                  b.setAttribute("aria-expanded", "false");
                });
              }
            });

            // Open this one
            setOpen(true);
          }
        });
      });
    });
  });
</script>
