---
import AnimatedTitle from "../../components/AnimatedTitle.astro";
import Button from "../../components/Button.astro";

type Translations = typeof import("../../i18n/en").default;
type ClientsContent = Translations["main"]["clients"];
interface Props {
  content: ClientsContent;
  lang: "es" | "en";
}
const { content, lang } = Astro.props as Props;
---

<section
  class="container-full py-16 md:py-20 grid grid-cols-1 md:grid-cols-3 md:grid-rows-2 gap-6"
>
  <div
    class="md:aspect-[410.6/525] flex flex-col gap-8 justify-center items-center md:items-start md:px-4 lg:px-17 text-paragraph mb-2 md:mb-0"
  >
    <AnimatedTitle text={content.title} tag="h2" class="title-2 w-full md:w-[264px] text-center md:text-left" />
    <Button
      text={content.button.label}
      href={`${lang}/${content.button.href}`}
      extraBtnClass="fade-up-slow [--delay:0.5s]"
    />
  </div>
  <div
    class="md:col-start-2 md:row-span-2 relative aspect-65/89 md:aspect-auto reveal-ltr"
  >
    <img
      src="/images/cliente-2.webp"
      alt="Client 2"
      class="w-full h-full object-cover object-[50%_20%] md:object-center"
      height="2090"
      width="800"
      decoding="async"
      loading="lazy"
    />
  </div>
  <div class="aspect-65/89 md:aspect-[410.6/525] relative reveal-rtl">
    <img
      src="/images/cliente-3.webp"
      alt="Client 3"
      class="w-full h-full object-cover absolute inset-0"
      height="1022"
      width="800"
      decoding="async"
      loading="lazy"
    />
  </div>
  <div class="aspect-[410.6/525] relative hidden md:block reveal-ltr">
    <img
      src="/images/cliente-1.webp"
      alt="Client 4"
      class="w-full h-full object-cover absolute inset-0"
      height="1022"
      width="800"
      decoding="async"
      loading="lazy"
    />
  </div>
  <div class="aspect-[410.6/525] relative hidden md:block reveal-rtl">
    <img
      src="/images/cliente-4.webp"
      alt="Client 4"
      class="w-full h-full object-cover absolute inset-0"
      height="1022"
      width="800"
      decoding="async"
      loading="lazy"
    />
  </div>
</section>
