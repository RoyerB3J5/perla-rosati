---
import Button from "../../components/Button.astro";
type Translations = typeof import("../../i18n/en").default;
type HeroContent = Translations["main"]["hero"];
interface Props {
  content: HeroContent;
}
const { content } = Astro.props as Props;

// Comprueba si la URL coincide con la raíz o los prefijos de idioma (/ , /es, /es/, /en, /en/)
const pathname = Astro.url.pathname;
const isHomePage = /^\/(en|es)?\/?$/.test(pathname);
---

<section
  class="w-full h-screen flex justify-center items-end overflow-hidden relative"
>
  <img
    src={`/images/${content.image}.webp`}
    alt="Hero image"
    width="2752"
    height="1720"
    class="z-0 w-full h-full absolute inset-0 object-cover object-top"
  />
  <div
    class="container-full flex justify-start items-center text-paragraph h-[calc(100vh-var(--header-height))] relative z-10 py-[1vw] 3xl:py-[4vw]"
  >
    <div class="flex flex-col justify-between items-start h-full max-w-[553px]">
      <div class="flex flex-col justify-center items-start gap-6">
        <p class="paragraph-medium tracking-[2.56px] uppercase">
          {content.tag}
        </p>
        <h1 class="title-1">{content.title}</h1>
      </div>
      <div
        class="pt-4 flex flex-col justify-center items-start gap-8 border-t-[1.5px] border-paragraph"
      >
        <p class="paragraph">{content.description}</p>
        <Button text={content.button.label} href={content.button.href} />
      </div>
    </div>
  </div>
</section>
