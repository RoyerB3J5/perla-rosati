---
type Translations = typeof import("../../i18n/en").default;
type LooksContent = Translations["main"]["looks"];
interface Props {
  content: LooksContent;
  lang: "es" | "en";
}
const { content, lang } = Astro.props as Props;
---

<section
  class="container-full flex justify-center items-center py-20 gap-20 relative"
>
  <div
    class="flex-1 h-auto relative overflow-hidden flex justify-start items-end p-10"
    style="aspect-ratio: 560/696;"
  >
    <img
      src="/images/looks-main.webp"
      alt="Looks Main"
      width="768"
      height="1024"
      class="object-cover w-full h-full absolute inset-0 z-0"
      decoding="async"
      loading="lazy"
    />
    <img
      src="/icons/logo-white.svg"
      alt="Logo"
      class="w-60 h-auto relative z-5"
      width="240"
      height="62"
      decoding="async"
      loading="lazy"
    />
  </div>
  <div
    class="w-[52%] h-auto bg-secondary py-21 flex flex-col justify-center items-center text-paragraph gap-14"
  >
    <div class="flex flex-col justify-center items-center gap-6 max-w-[532px]">
      <p
        class="paragraph-medium tracking-[2.56px] uppercase w-[80%] text-center"
      >
        {content.tag}
      </p>
      <h2 class="title-2">{content.title}</h2>
    </div>
    <img
      src="/images/looks-2-main.webp"
      alt="Looks Main 2"
      width="240"
      height="240"
      class="w-60 h-60"
      decoding="async"
      loading="lazy"
    />
    <div class="flex flex-col justify-center items-center gap-8 max-w-[368px]">
      <p class="text-center paragraph">{content.description}</p>
      <a
        href={`${lang}/${content.link.href}`}
        class="paragraph-medium tracking-[2.56px] uppercase py-2 border-b-[1.5px] border-paragraph"
        >{content.link.label}
      </a>
    </div>
  </div>
</section>
