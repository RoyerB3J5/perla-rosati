---
import AnimatedTitle from "../../components/AnimatedTitle.astro";
import Button from "../../components/Button.astro";

type Translations = typeof import("../../i18n/en").default;
type ProcessContent = Translations["main"]["process"];
interface Props {
  content: ProcessContent;
  lang: "es" | "en";
}
const { content, lang } = Astro.props as Props;
---

<section
  class="container-full flex justify-center items-center flex-col gap-12 pt-16 pb-20 md:py-20"
>
  <div
    class="w-full flex flex-col md:flex-row justify-center md:justify-between items-center gap-6 md:gap-0"
  >
    <AnimatedTitle
      text={content.title}
      tag="h2"
      class="title-2 md:text-start text-center max-w-none md:max-w-[60%] xl:max-w-none"
    />
    <Button
      text={content.button.label}
      href={`/${lang}${content.button.href}`}
      extraBtnClass="fade-up-slow [--delay:0.5s]"
    />
  </div>
  <div
    class="w-full grid grid-cols-1 md:grid-cols-3 justify-center items-start gap-6"
  >
    {
      content.items.map((item, index) => (
        <div class="flex flex-col justify-center items-start gap-6">
          <div
            class="w-full h-auto relative overflow-hidden reveal-tl-br"
            style={`aspect-ratio: 410.6/566.6; transition-delay: ${index * 0.2}s`}
          >
            <img
              src={`/images/${item.image}.webp`}
              alt={item.title}
              class="w-full h-full object-cover absolute inset-0"
              width="1000"
              height="1377"
            />
          </div>
          <div class="w-full h-[1.5px] bg-paragraph fade-up-a" />
          <h3 class="paragraph-medium uppercase fade-up-a">{item.title}</h3>
          <p class="paragraph fade-up-a">{item.description}</p>
        </div>
      ))
    }
  </div>
</section>
