---
import Button from "../../components/Button.astro";

type Translations = typeof import("../../i18n/en").default;
type ProcessContent = Translations["main"]["process"];
interface Props {
  content: ProcessContent;
  lang: "es" | "en";
}
const { content, lang } = Astro.props as Props;
---

<section
  class="container-full flex justify-center items-center flex-col gap-12 py-20"
>
  <div class="w-full flex justify-between items-center">
    <h2 class="title-2">{content.title}</h2>
    <Button
      text={content.button.label}
      href={`${lang}/${content.button.href}`}
    />
  </div>
  <div class="w-full grid grid-cols-3 justify-center items-start gap-6">
    {
      content.items.map((item) => (
        <div class="flex flex-col justify-center items-start gap-6">
          <div
            class="w-full h-auto relative overflow-hidden"
            style="aspect-ratio: 410.6/566"
          >
            <img
              src={`/images/${item.image}.webp`}
              alt={item.title}
              class="w-full h-full object-cover absolute inset-0"
              width="1000"
              height="1377"
            />
          </div>
          <div class="w-full h-[1.5px] bg-paragraph" />
          <h3 class="paragraph-medium uppercase">{item.title}</h3>
          <p class="paragraph">{item.description}</p>
        </div>
      ))
    }
  </div>
</section>
