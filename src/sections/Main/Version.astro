---
import AnimatedTitle from "../../components/AnimatedTitle.astro";
import Button from "../../components/Button.astro";

type Translations = typeof import("../../i18n/en").default;
type VersionContent = Translations["main"]["version"];
interface Props {
  content: VersionContent;
  lang: "es" | "en";
}
const { content, lang } = Astro.props as Props;
---

<section
  class="w-[calc(100%-2rem)] md:w-full h-auto flex justify-center items-center overflow-hidden relative aspect-398/808 md:aspect-1440/950 xl:aspect-1440/808 mx-auto md:mx-0 reveal-rtl"
>
  <img
    src="/images/version.webp"
    alt="Version"
    class="w-full h-full absolute object-cover inset-0 z-0"
    width="2500"
    height="1443"
    decoding="async"
    loading="lazy"
  />
  <div
    class="max-w-[800px] xl:max-w-[534px] flex flex-col justify-between items-center px-4 md:px-0 py-17 md:py-8 lg:py-12 xl:py-17 w-full text-paragraph relative z-5 h-full"
  >
    <AnimatedTitle text={content.title} tag="h2" class="title-2 text-center" />
    <div class="flex flex-col justify-center items-center gap-8 md:gap-4 lg:gap-8">
      <p class="paragraph text-center w-[90%] fade-up-a">{content.descripcion}</p>
      <Button
        text={content.button.label}
        href={`/${lang}${content.button.href}`}
        extraBtnClass="fade-up-slow [--delay:0.5s]"
      />
    </div>
  </div>
</section>
